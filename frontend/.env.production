# `vite build` (modo production). Gana a `.env.local` (Vercel CLI / develop).
# NO poner VITE_CAPACITOR=true: en Vercel getApiUrl() debe seguir usando /api relativo.
# El script build:android sí exporta VITE_CAPACITOR y esta misma URL (por si acaso).
VITE_API_URL=https://fichajesbodegasalvaro-production.up.railway.app
