# ─── Backend ────────────────────────────────────────────────────────────────
# JWT Secret (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3001

# Entorno
NODE_ENV=production

# ─── Base de datos PostgreSQL ────────────────────────────────────────────────
# Railway añade esta variable automáticamente al conectar una BD PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# ─── CORS - URL del frontend en Vercel ───────────────────────────────────────
FRONTEND_URL=https://tu-app.vercel.app
