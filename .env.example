# ─── Variables de entorno ──────────────────────────────────────────────────────
# Copia este archivo a .env y rellena los valores

# Secreto JWT — OBLIGATORIO en producción
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro_generado_con_crypto_randomBytes

# Puerto (Railway lo sobreescribe automáticamente)
PORT=3001

# Entorno
NODE_ENV=development

# Ruta de la base de datos SQLite
# Desarrollo local: dejar vacío (usa ./data/fichajes.db)
# Railway: /data/fichajes.db (Volume montado)
# DB_PATH=/data/fichajes.db

# URL de la app (solo si necesitas restringir CORS)
# FRONTEND_URL=https://tu-app.up.railway.app
