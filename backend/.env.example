JWT_SECRET=cambia_esto_por_un_secreto_seguro_en_produccion
PORT=3001
NODE_ENV=production
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Sincronizacion bidireccional con Odoo 18
ODOO_URL=https://tpv.bodegas-alvaro.com
ODOO_DB=bodegas
ODOO_USER=admin
ODOO_PASSWORD=
# Alternativa a ODOO_PASSWORD: clave API del usuario tecnico Odoo
ODOO_API_KEY=
# Secreto compartido con Odoo (header X-Odoo-Sync-Key); mismo valor que FICHAJES_SYNC_API_KEY en Odoo
ODOO_SYNC_API_KEY=
# Local PoC: http://localhost:8069 (host) o http://host.docker.internal:8069 (desde contenedor)

# SSO admin Odoo -> Fichajes (HMAC, distinto de ODOO_SYNC_API_KEY)
ODOO_SSO_SECRET=
FRONTEND_URL=http://localhost:5173
